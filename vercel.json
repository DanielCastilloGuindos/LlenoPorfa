{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "bun install",
  "buildCommand": "bun run build:vercel",
  "builds": [
    {
      "src": "apps/api/api/*.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10,
        "memory": 1024,
        "includeFiles": [
          "apps/api/src/infrastructure/database/schema.sql",
          "apps/common/dist/**"
        ]
      }
    },
    {
      "src": "apps/register/api/*.rs",
      "use": "vercel-rust@4.0.9",
      "config": {
        "maxDuration": 30,
        "memory": 1024
      }
    },
    {
      "src": "apps/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "apps/manager/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/sync?target=all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/sync?target=crude",
      "schedule": "30 22 * * *"
    }
  ],
  "regions": ["cdg1"],
  "routes": [
    {
      "src": "/api/stations/(.*)/history",
      "dest": "/apps/api/api/stations.ts?stationId=$1",
      "headers": {
        "Cache-Control": "public, s-maxage=600, stale-while-revalidate=120"
      }
    },
    {
      "src": "/api/stations",
      "dest": "/apps/api/api/stations.ts",
      "headers": {
        "Cache-Control": "public, s-maxage=300, stale-while-revalidate=60"
      }
    },
    {
      "src": "/api/filters",
      "dest": "/apps/api/api/filters.ts",
      "headers": {
        "Cache-Control": "public, s-maxage=3600, stale-while-revalidate=600"
      }
    },
    {
      "src": "/api/market/crude-history",
      "dest": "/apps/api/api/market.ts?mode=crude-history",
      "headers": {
        "Cache-Control": "public, s-maxage=3600, stale-while-revalidate=600"
      }
    },
    {
      "src": "/api/market",
      "dest": "/apps/api/api/market.ts",
      "headers": {
        "Cache-Control": "public, s-maxage=3600, stale-while-revalidate=600"
      }
    },
    {
      "src": "/api/sync/(.*)",
      "dest": "/apps/api/api/sync.ts?target=$1",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/api/sync",
      "dest": "/apps/api/api/sync.ts",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/api/register/event",
      "dest": "/apps/register/api/event",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/api/register/stats",
      "dest": "/apps/register/api/stats",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "src": "/manager/(.*)",
      "dest": "/apps/manager/$1"
    },
    {
      "src": "/manager",
      "dest": "/apps/manager/index.html"
    },
    {
      "src": "/sw.js",
      "dest": "/apps/client/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "/manifest.webmanifest",
      "dest": "/apps/client/manifest.webmanifest",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Type": "application/manifest+json; charset=utf-8"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/client/$1"
    }
  ]
}
