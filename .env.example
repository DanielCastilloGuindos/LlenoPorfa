# ==========================================================
# LlenoPorfa Environment Variables
# ==========================================================

# Server Port
PORT=3002

# Database Configuration (Turso / libSQL / SQLite)
# If TURSO_DATABASE_URL is left empty, the API automatically uses local SQLite at data/llenoporfa.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SQLITE_PATH=./data/llenoporfa.db

# External Market Data APIs
# Optional key for https://api.oilpriceapi.com/v1/prices/latest (fallback to Yahoo Finance if empty)
OILPRICEAPI_KEY=

# Internal Background Scheduler
# Set to 'true' or '1' to start the local background cron sync interval runner
ENABLE_CRON_SYNC=false

# Vercel Cron Security
# Optional secret token to authenticate Vercel Cron requests (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
