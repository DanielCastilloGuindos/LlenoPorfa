{
  "name": "llenoporfa",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter @llenoporfa/client dev",
    "dev:manager": "bun --filter @llenoporfa/manager dev",
    "dev:api": "bun --watch run apps/api/src/index.ts",
    "dev:all": "concurrently \"bun --watch run apps/api/src/index.ts\" \"bun --filter @llenoporfa/client dev\"",
    "dev:full": "concurrently \"bun --watch run apps/api/src/index.ts\" \"bun --filter @llenoporfa/client dev\" \"bun --filter @llenoporfa/manager dev\"",
    "build": "bun --filter @llenoporfa/client build",
    "build:all": "bun --filter @llenoporfa/client build && bun --filter @llenoporfa/manager build",
    "test": "bun test apps/api",
    "preview": "bun --filter @llenoporfa/client preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "sharp": "^0.35.5"
  }
}
